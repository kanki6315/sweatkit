.DS_Store

# Swift packages
.build/
.swiftpm/

# Xcode. The project is generated from project.yml with `xcodegen generate`.
*.xcodeproj
DerivedData/
xcuserdata/

# Local Impeccable settings and runtime artifacts. Shared design context is tracked.
.impeccable/config.local.json
.impeccable/questions/
.impeccable/mocks/
.impeccable/review/
.impeccable/critique/*
!.impeccable/critique/ignore.md

# Local release credentials and generated archives/logs
.release.env
build/
__pycache__/
