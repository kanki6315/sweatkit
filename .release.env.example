# Copy to .release.env. Shell syntax; never commit credentials.
# DEVELOPMENT_TEAM defaults to project.yml.
# DEVELOPMENT_TEAM=TDBAHN96B3
# Defaults to the Apple ID signed into Xcode. Optional App Store Connect key:
# ASC_KEY_ID=ABC123DEF4
# ASC_ISSUER_ID=12345678-aaaa-bbbb-cccc-1234567890ab
# ASC_KEY_PATH="$HOME/.appstoreconnect/private_keys/AuthKey_ABC123DEF4.p8"
# Requires a local Apple Distribution certificate and its private key.
# DEVELOPER_DIR=/Applications/Xcode.app/Contents/Developer
# Select an installed model/runtime from `simlock catalog`, or let Simlock pick.
# SIMLOCK_DEVICE='iPhone 18 Pro'
# SIMLOCK_OS=27.2
